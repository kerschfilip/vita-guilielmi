<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?><?xml-model href="http://www.tei-c.org/release/xml/tei/custom/schema/relaxng/tei_all.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?><TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:tei="http://www.tei-c.org/ns/1.0" xml:id="pb-persons">
    <teiHeader>
        <fileDesc>
            <titleStmt>
                <title>Persons Register — Vita Guilielmi</title>
            </titleStmt>
            <publicationStmt>
                <p>Publication Information</p>
            </publicationStmt>
            <sourceDesc>
                <p>Information about the source</p>
            </sourceDesc>
        </fileDesc>
    </teiHeader>
    <standOff>
        <listPerson>

            <person xml:id="p_iacobus_pater">
                <persName type="main">Iacobus (pater)</persName>
                <note type="role">Addressee of the Prologus (pater / superior), as named in the MS.</note>
            </person>

            <person xml:id="p_iacobus_apostolus">
                <persName type="main">Iacobus Apostolus</persName>
                <note type="role">Apostle James; pilgrimage shrine in the itinerary frame.</note>
            </person>

            <person xml:id="p_guilielmus">
                <persName type="main">Guilielmus</persName>
                <persName type="sort">Guilielmus</persName>
                <note type="role">Subject of the Vita; founder of Montevergine.</note>
                <idno type="VIAF">190751093</idno>
                <idno type="Wikidata">Q2197784</idno>
                <birth when="1085">1085</birth>
                <death when="1142">1142</death>
            </person>

            <person xml:id="p_iohannes_discipulus">
                <persName type="main">Iohannes (discipulus)</persName>
                <persName type="sort">Iohannes discipulus</persName>
                <note type="role">Disciple/holy companion of Guilielmus; abbot/founder figure linked to Genusium.</note>
            </person>

            <person xml:id="p_albertus">
                <persName type="main">Albertus</persName>
                <note type="role">Monk received into Guilielmus' community; later designated superior/abbot.</note>
            </person>

            <person xml:id="p_roggerius_rex">
                <persName type="main">Rogerius Rex</persName>
                <persName type="sort">Rogerius Rex</persName>
                <note type="role">King; political pacifier/liberator of Apulia; historical framing in both witnesses.</note>
                <idno type="Wikipedia">https://it.wikipedia.org/wiki/Ruggero_II_di_Sicilia</idno>
            </person>

            <person xml:id="p_iohannes_episc_avellino">
                <persName type="main">Ioannes (episcopus Avellini)</persName>
                <persName type="sort">Ioannes episcopus Avellini</persName>
                <note type="role">Bishop of Avellino who consecrates/dedicates the church.</note>
            </person>

            <person xml:id="p_petrus_socius_mons">
                <persName type="main">Petrus (socius)</persName>
                <note type="role">Companion/guide on the ascent to Mons Virginis; associated with the search for water.</note>
            </person>

            <person xml:id="p_faber_ferrarius">
                <persName type="main">faber ferrarius</persName>
                <note type="role">Hospitator of Guilielmus during the early pilgrimage; provides iron circles for mortification. Anonymous in both witnesses.</note>
            </person>

            <person xml:id="p_matrona_atripaldum">
                <persName type="main">matrona Atripaldi</persName>
                <note type="role">Unnamed woman in Atripaldum who hosts Guilielmus and advises about the mountain hermit.</note>
            </person>

            <person xml:id="p_baiulus_mercuriani">
                <persName type="main">baiulus Mercuriani</persName>
                <note type="role">Local official who releases Guilielmus after recognising his sanctity. Anonymous in both witnesses.</note>
            </person>

            <person xml:id="p_gualterius">
                <persName type="main">Gualterius</persName>
                <note type="role">Ligure architectus; miraculously healed of a withered arm during construction of the church on Mons Virginis; later disciple of Guilielmus (Renda 1581).</note>
            </person>

            <person xml:id="p_felix_renda">
                <persName type="main">Felix Renda</persName>
                <persName type="sort">Renda, Felix</persName>
                <note type="role">Editor/compilator of the 1581 printed edition; author of prefatory materials.</note>
            </person>

            <person xml:id="p_guido_de_ferreriis">
                <persName type="main">Guido de Ferreriis</persName>
                <persName type="sort">Ferreriis, Guido de</persName>
                <note type="role">Dedicatee in the 1581 paratext (cardinal).</note>
            </person>

            <person xml:id="p_io_franciscus_lombardus">
                <persName type="main">Ioannes Franciscus Lombardus</persName>
                <persName type="sort">Lombardus, Ioannes Franciscus</persName>
                <note type="role">Neapolitan; author of the Octastichon addressed to Felice Renda.</note>
            </person>

            <person xml:id="p_paulus_regius">
                <persName type="main">Paulus Regius</persName>
                <persName type="sort">Regius, Paulus</persName>
                <note type="role">Neapolitan theologian.</note>
            </person>

            <person xml:id="p_constantia_regis">
                <persName type="main">Constantia</persName>
                <note type="role">Regis filia; monialis Montis Virginis; donor of Mercuriani territory.</note>
            </person>

            <person xml:id="p_henricus_v">
                <persName type="main">Henricus V</persName>
                <note type="role">Romanorum Imperator Augustus; husband of Constantia.</note>
                <idno type="Wikipedia">https://it.wikipedia.org/wiki/Enrico_V_del_Sacro_Romano_Impero</idno>
            </person>

            <person xml:id="p_carolus_v">
                <persName type="main">Carolus V</persName>
                <note type="role">Imperator Romanorum Augustus; confirmer of privileges.</note>
                <idno type="Wikipedia">https://it.wikipedia.org/wiki/Carlo_V_d%27Asburgo</idno>
            </person>

            <person xml:id="p_lucius_iii">
                <persName type="main">Lucius III</persName>
                <note type="role">Sanctae Sedis Pontifex Maximus.</note>
            </person>

            <person xml:id="p_gregorius_xiii">
                <persName type="main">Gregorius XIII</persName>
                <note type="role">Pontifex Romanus; grantor of indulgences and exemptions.</note>
            </person>

        </listPerson>
    </standOff>
</TEI>